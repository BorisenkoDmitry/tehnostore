# Copy to .env.production.local on the deployment host; never commit real values.
PUBLIC_URL=https://tehnostore.dmitriy-borisenko.ru
IMAGE_TAG=production
# Generate independent random hex values (URL-safe in DATABASE_URL).
POSTGRES_BOOTSTRAP_PASSWORD=
MEDUSA_DB_PASSWORD=
JWT_SECRET=
COOKIE_SECRET=
# Use the publishable key belonging to the restored store/sales channel.
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
NEXT_PUBLIC_DEFAULT_REGION=dk
# Build-only address: a running backend containing the real store data.
# Docker Desktop local build: http://host.docker.internal:9000
# Server: use the public backend URL after routing /store to the bootstrapped backend,
# or the Linux host-network build method documented in deploy/README.md.
MEDUSA_BUILD_BACKEND_URL=http://host.docker.internal:9000
BACKEND_BOOTSTRAP_PORT=9002
GATEWAY_DEBUG_PORT=3108
