{
  "name": "dtc-starter-monorepo",
  "private": false,
  "packageManager": "pnpm@10.11.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "pnpm -r dev",
    "build": "pnpm -r build",
    "start": "turbo start",
    "lint": "turbo lint",
    "test": "turbo test",
    "backend:seed": "turbo seed --filter=@dtc/backend",
    "backend:dev": "turbo dev --filter=@dtc/backend",
    "storefront:dev": "turbo dev --filter=@dtc/storefront",
    "qa": "node qa/run.cjs"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.0.5",
      "@types/react-dom": "19.0.5",
      "tsconfig-paths": "^4.2.0"
    },
    "patchedDependencies": {
      "@medusajs/dashboard@2.22.3": "patches/@medusajs__dashboard@2.22.3.patch",
      "@medusajs/medusa@2.22.3": "patches/@medusajs__medusa@2.22.3.patch",
      "@medusajs/ui@4.2.10": "patches/@medusajs__ui@4.2.10.patch",
      "@medusajs/framework@2.22.3": "patches/@medusajs__framework@2.22.3.patch",
      "@medusajs/core-flows@2.22.3": "patches/@medusajs__core-flows@2.22.3.patch",
      "@medusajs/inventory@2.22.3": "patches/@medusajs__inventory@2.22.3.patch",
      "@medusajs/orchestration@2.22.3": "patches/@medusajs__orchestration@2.22.3.patch",
      "@medusajs/workflow-engine-inmemory@2.22.3": "patches/@medusajs__workflow-engine-inmemory@2.22.3.patch"
    }
  },
  "devDependencies": {
    "@medusajs/eslint-plugin": "2.22.3",
    "eslint": "^9.39.4",
    "jiti": "^2.7.0",
    "prettier": "^3.2.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "turbo": "^2.0.14"
  }
}
