diff --git a/dist/texno-sidebar.cjs b/dist/texno-sidebar.cjs
new file mode 100644
index 0000000..aea47b3
--- /dev/null
+++ b/dist/texno-sidebar.cjs
@@ -0,0 +1,40 @@
+const sectionDefinitions = [
+  ["sales", "Продажи", "Sales", ["/orders", "/customers", "/content-leads", "/customer-orders"]],
+  ["catalog", "Каталог", "Catalog", ["/catalog-constructor", "/catalog-constructor/products", "/catalog-constructor/categories", "/catalog-constructor/variants", "/products", "/collections", "/inventory", "/insales-import"]],
+  ["pricing", "Цены и акции", "Pricing and promotions", ["/price-lists", "/promotions"]],
+  ["storefront", "Витрина", "Storefront", ["/content-pages", "/navigation", "/content-footer", "/content-reviews", "/storefront/cart"]],
+  ["settings", "Настройки", "Settings", ["/content-settings", "/settings"]]
+];
+
+function getSidebarGroups(routes, language, icons) {
+  const russian = language?.toLowerCase().startsWith("ru");
+  const remaining = new Map(routes.map((route) => [route.to, route]));
+  remaining.delete("/catalog-trash");
+  const catalog = remaining.get("/catalog-constructor");
+  if (catalog) {
+    remaining.set(catalog.to, { ...catalog, label: russian ? "Конструктор" : "Catalog builder", items: undefined, exact: true });
+    for (const item of catalog.items ?? []) {
+      if (item.to !== "/catalog-constructor/trash") remaining.set(item.to, item);
+    }
+    // The constructor links to import and recovery from its toolbar.
+    remaining.delete("/insales-import");
+  }
+  const customers = remaining.get("/customers");
+  if (customers && russian) remaining.set(customers.to, { ...customers, label: "Покупатели" });
+  // The Orders and Customers lists each link to their own view of the directory.
+  if (remaining.has("/orders") || customers) remaining.delete("/customer-orders");
+
+  const sections = sectionDefinitions.map(([id, label, englishLabel, paths]) => {
+    const items = [];
+    for (const path of paths) {
+      const route = remaining.get(path);
+      if (route) items.push(icons[path] && !route.icon ? { ...route, icon: icons[path] } : route);
+      remaining.delete(path);
+    }
+    return { id, label: russian ? label : englishLabel, items };
+  });
+  sections.push({ id: "extensions", label: russian ? "Дополнения" : "Extensions", items: [...remaining.values()] });
+  return sections.filter(({ items }) => items.length > 0);
+}
+
+module.exports = { getSidebarGroups };
