diff --git a/dist/app.css b/dist/app.css
index b32cffa..8e07b3f 100644
--- a/dist/app.css
+++ b/dist/app.css
@@ -5488,3 +5488,79 @@ button:not(:disabled),
 .\[\&_tr\]\:hover\:bg-ui-bg-subtle:hover tr {
   background-color: var(--bg-subtle);
 }
+
+/* TEXNO Store admin shell */
+.texno-admin-sidebar {
+  --bg-subtle: #171e2d;
+  --bg-base: #293855;
+  --bg-subtle-hover: #222e43;
+  --bg-base-hover: #303f5c;
+  --button-transparent-hover: #222e43;
+  --button-transparent-pressed: #293855;
+  --border-base: #303d52;
+  --fg-base: #f3f6fc;
+  --fg-subtle: #c5cede;
+  --fg-muted: #a2afc4;
+  --borders-focus: 0 0 0 2px #aabaff;
+  background-color: var(--bg-subtle);
+  color: var(--fg-base);
+  scrollbar-color: #46536c var(--bg-subtle);
+}
+.texno-admin-sidebar-desktop {
+  width: 232px;
+}
+.texno-admin-store-header {
+  z-index: 1;
+}
+.texno-admin-nav-search {
+  margin-bottom: 12px;
+}
+.texno-admin-nav-search button {
+  min-height: 34px;
+  background-color: #202a3d;
+  box-shadow: inset 0 0 0 1px #35425a;
+}
+.texno-admin-nav-search button:hover {
+  background-color: #29364e;
+}
+.texno-admin-nav-search button:focus-visible {
+  box-shadow: var(--borders-focus);
+}
+.texno-admin-nav-section {
+  padding-top: 10px;
+}
+.texno-admin-nav-section h2 {
+  color: var(--fg-muted);
+  font-size: 10px;
+  line-height: 16px;
+  letter-spacing: 0.065em;
+  text-transform: uppercase;
+}
+.texno-admin-nav-section a {
+  min-height: 30px;
+}
+.texno-admin-nav-section a .shadow-borders-base {
+  background: transparent;
+  box-shadow: none;
+}
+.texno-admin-sidebar nav a[aria-current="page"],
+.texno-admin-sidebar nav a.shadow-elevation-card-rest {
+  background-color: #303f61;
+  color: #fff;
+  box-shadow: inset 0 0 0 1px #495c84;
+}
+.texno-admin-sidebar nav a[aria-current="page"] svg,
+.texno-admin-sidebar nav a.shadow-elevation-card-rest svg {
+  color: #c1cbff;
+}
+.texno-admin-sidebar nav a:focus-visible {
+  outline: 2px solid #aabaff;
+  outline-offset: -2px;
+}
+.texno-admin-workspace {
+  background-color: var(--bg-subtle);
+  background-color: color-mix(in srgb, var(--bg-subtle) 91%, #8397b6);
+}
+.texno-admin-topbar {
+  background-color: var(--bg-base);
+}
